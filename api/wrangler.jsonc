{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bpct-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bpc-control-tower",
      "database_id": "028fb4a3-9640-43ff-8a15-8c34c4a93baf",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Comma-separated origins allowed by CORS. "*." matches one subdomain level,
    // e.g. "https://*.business-performance-control-tower.pages.dev" for Pages preview deployments.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://business-performance-control-tower.pages.dev,https://*.business-performance-control-tower.pages.dev"
  }
}
